<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>UndercutF1.Gui</RootNamespace>
    <!-- The repo defaults to AOT-friendly, source-generated JSON (no runtime reflection).
         This project's own DTOs are plain POCOs with no source-generated JsonSerializerContext,
         so re-enable reflection-based System.Text.Json for this process only. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../UndercutF1.Data/UndercutF1.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="InMemoryLogger" />
  </ItemGroup>
</Project>
